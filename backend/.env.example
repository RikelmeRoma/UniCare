# Configuração de ambiente do backend UniCare.
# Copie para `.env` e ajuste os valores. O arquivo `.env` NÃO é versionado.

# --- Banco de dados ---
# OBRIGATÓRIO: não existe valor padrão no código. Sem esta variável a aplicação
# falha na importação com "ValidationError: DATABASE_URL — Field required".
# PostgreSQL dockerizado (backend/docker-compose.yml, serviço `db`).
# O host é `localhost` ao rodar a API na máquina; use `db` se rodar dentro do container.
# A porta pública é 5433 porque esta máquina tem um PostgreSQL nativo ocupando a 5432.
DATABASE_URL=postgresql+psycopg2://unicare_user:unicare_password123@localhost:5433/unicare_db

# --- Segurança JWT ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-chave-aleatoria-de-no-minimo-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
# Origens liberadas, separadas por virgula. NAO usar "*": junto de
# allow_credentials=True o Starlette reflete qualquer origin e a lista vira codigo
# morto. Para liberar uma origem nova (front servido por nginx, outra porta do
# Vite), acrescente aqui e reinicie a API. 5174 entra porque o Vite cai para essa
# porta quando a 5173 esta ocupada.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Envio de e-mail (recuperação de senha e senha inicial de credencial) ---
# TODAS opcionais: sem elas a recuperação por e-mail responde 503 e a tela
# orienta procurar a coordenação. A ausência aqui não é erro de configuração.
#
# Gmail:  MAIL_HOST=smtp.gmail.com
#         MAIL_PORT=587
# Outlook: MAIL_HOST=smtp-mail.outlook.com
# MAIL_PASSWORD é a SENHA DE APP, não a senha da conta: 16 caracteres do
# Google, SEM espaços (a tela mostra em grupos de quatro — "abcd efgh ijkl
# mnop" — mas o segredo são os 16 colados). Com a senha da conta ou com os
# espaços, o servidor responde 535 e o e-mail não sai.
# MAIL_FROM vazio = o e-mail sai da própria conta (MAIL_USER), que é o que o
# Gmail e o Yahoo exigem: remetente diferente da conta autenticada é
# reescrito ou recusado.
# MAIL_PORT=465 é TLS implícito (SMTP_SSL); 587 é STARTTLS.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TLS=true
MAIL_TIMEOUT_SEGUNDOS=10

# --- Política de e-mail do pedido de credencial ---
# Fechado por padrão: só os domínios institucionais entram na fila pública do
# /cadastro. Ligue apenas quando a instituição precisar receber o pedido em
# outro domínio (por exemplo, um Gmail que a pessoa realmente acessa). A
# aprovação da gestão continua sendo o gate: nada é criado sem ela.
PERMITIR_EMAILS_EXTERNOS=false

# Validade do código de recuperação, em minutos. Curto por princípio: é um
# segredo de uso único, não uma credencial de sessão.
TOKEN_RECUPERACAO_MINUTOS=15