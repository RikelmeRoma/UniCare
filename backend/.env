# Origens liberadas no CORS, separadas por virgula. NAO usar "*": junto com
# allow_credentials=True o Starlette reflete qualquer origin e a lista vira
# codigo morto. Para liberar uma origem nova (ex.: o front servido por nginx),
# acrescente aqui e reinicie a API. 5174 entra porque o Vite cai para essa porta
# quando a 5173 esta ocupada.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

